# Copy this file to .env and fill in the blank values. Never commit .env.

NODE_ENV=development
PORT=5000
APP_NAME=
LOG_LEVEL=info

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public"

# Public base URL of this backend, used for payment return links.
SERVER_URL=http://localhost:5000
# Allowed CORS origin for the browser client.
FRONTEND_URL=http://localhost:3000

BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

REDIS_USER=default
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=

SMTP_USER=
SMTP_PASSWORD=
EMAIL_SENDER=

# Used by prisma/seed.ts to create the first admin account.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# @feature google
GOOGLE_CLIENT_ID=
# @end

# @feature uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# @end

# @feature stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# @end

